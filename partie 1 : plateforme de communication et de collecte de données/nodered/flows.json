    {
        "id": "f74e8dab19e4ca21",
        "type": "function",
        "z": "7bdf26f7f8d6c9e0",
        "name": "distance -> courbe + CSV",
        "func": "// Lire la distance reçue de l'Arduino\nvar d = msg.payload.distance;\n\n// Ignorer les mesures invalides (-1 = pas d'écho)\nif (d === undefined || d < 0) return null;\n\n// Date et heure actuelles\nfunction p(n){ return (n < 10 ? '0' : '') + n; }\nvar t = new Date();\nvar date  = p(t.getDate()) + '/' + p(t.getMonth()+1) + '/' + t.getFullYear();\nvar heure = p(t.getHours()) + ':' + p(t.getMinutes()) + ':' + p(t.getSeconds());\n\n// Sortie 1 : courbe + jauge\nvar msgCourbe = { topic: 'Distance', payload: d };\n\n// Sortie 2 : ligne pour Excel\nvar msgExcel = { payload: {\n    Date: date,\n    Heure: heure,\n    Distance_cm: d.toFixed(2).replace('.', ','),\n    Obstacle: (msg.payload.alarme === 'DANGER') ? 'OUI' : 'NON'   // obstacle a 10 cm ou moins\n}};\n\nreturn [msgCourbe, msgExcel];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 240,
        "wires": [
            [
                "4950dd0490367dc6"
            ],
            [
                "9fd99f3d2223a5fa"
            ]
        ]
